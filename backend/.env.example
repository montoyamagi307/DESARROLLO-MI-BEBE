# ============================================================================
# VITACHRONICLE BACKEND - VARIABLES DE ENTORNO DE EJEMPLO
# Copia este archivo como .env y ajusta los valores para tu entorno.
# ============================================================================

# Configuración del Servidor
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vitachronicle_db
DB_USER=vitadev
DB_PASSWORD=vitasecret2026
DB_SSL=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000

# Seguridad y Autenticación JWT
JWT_SECRET=super_secret_jwt_key_change_in_production_vita_2026
JWT_EXPIRES_IN=7d

# Almacenamiento Local de Archivos y PDFs
STORAGE_DIR=./uploads
PDF_OUTPUT_DIR=./uploads/books

# Configuración de Privacidad y Límites
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_UPLOAD_SIZE_MB=15
